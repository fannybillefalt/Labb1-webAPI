@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-4 text danger">
        Något gick fel
    </h1>

    <p>@Model.Message</p>

    <hr />

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary mt-3">
        Till startsidan
    </a>
</div>